# API Configuration
# 支持任何兼容 OpenAI 格式的接口，包括 DeepSeek、OpenRouter、Claude (通过中转/代理)、SiliconFlow、Ollama 等

# 1. 如果使用 DeepSeek (性价比最高，推荐):
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# 2. 如果使用 OpenRouter (支持 Claude 3.5/3.7 Sonnet, GPT-4o 等):
# OPENAI_API_KEY=sk-or-v1-xxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=anthropic/claude-3.5-sonnet

# 3. 如果使用本地 Ollama (完全离线本地免费运行):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5-coder:7b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
